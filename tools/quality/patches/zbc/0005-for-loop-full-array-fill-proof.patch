+    /// The root local that `for_node`'s body provably initialises in
+    /// full on normal completion, or null when that is not proved.
+    ///
+    /// WHY IT IS NEEDED.  `lowerFor` gives every loop an unconditional
+    /// edge from its header to its exit, so a local read after the loop
+    /// is reachable along a path where the body never ran.  For the
+    /// compile-time table idiom — a fixed array filled by
+    /// `inline for (table, 0..) |v, i| arr[i] = v` and then returned —
+    /// that path does not exist, and without this the `return arr` is
+    /// reported as returning a value that is still `undefined`.
+    ///
+    /// WHAT IS NOT PROVED, and why each keeps reporting:
+    ///   - a body that is not exactly one statement, or whose single
+    ///     statement is neither an assignment nor a `for` — so no `if`,
+    ///     no `while`, no `break`, no `continue`, no second statement
+    ///   - an LHS index that is a constant rather than the enclosing
+    ///     loop's own counter capture (`arr[0] = v`)
+    ///   - a counter range that does not start at zero (`1..3`)
+    ///   - a counter range whose length is not the dimension it indexes
+    ///     (`0..2` into `[4]u32`)
+    ///   - an input with no compile-time length (a runtime slice), or
+    ///     one whose length is zero
+    ///   - a nested `for` that fills part of a row, or an outer body that
+    ///     fills part of the rows
+    ///   - a value that is `undefined`, or that carries `break`, `continue`
+    ///     or `return`: one assignment whose value is not a value leaves the
+    ///     element as undefined as it was, or never writes it at all
+    ///   - an `else` on a NESTED loop, which runs inside the enclosing body
+    ///     and can write or reset the buffer after the fill was proved
+    ///
+    /// The proof never claims which ELEMENTS were written.  It
+    /// establishes that the index chain covers every dimension of the
+    /// root's fixed array exactly, which is the fact the single
+    /// per-local `undefined` bit can then honestly carry.
+    ///
+    /// `levels` is the caller's stack — the counter/length pairs the
+    /// enclosing loops established, outermost first — and `depth` is how
+    /// many of them are live.  Nothing here allocates.
+    fn fullFillRoot(
+        self: *Builder,
+        for_node: Ast.Node.Index,
+        levels: *[max_fill_depth]FillLevel,
+        depth: usize,
+    ) ?LocalId {
+        if (depth >= max_fill_depth) return null;
+        const tree = self.tree;
+        const loop = tree.fullFor(for_node) orelse return null;
+        // A NESTED loop's `else` runs on that loop's own normal completion,
+        // inside the enclosing body, and this walk never looks at it — so
+        // an `else` there can write or reset the buffer after the fill has
+        // been proved.  Refuse it.  The OUTER loop's `else` is a different
+        // matter and is exactly where the emitted `.pointer_write` goes: it
+        // runs after the whole fill, which is the order the else-read test
+        // pins.
+        if (depth > 0 and loop.ast.else_expr != .none) return null;
+
+        // Exactly one statement, and that statement an assignment or a
+        // single nested `for`.  Anything else can skip the write.
+        var buf: [2]Ast.Node.Index = undefined;
+        const stmts = blockStmts(tree, loop.ast.then_expr, &buf);
+        const stmt: Ast.Node.Index = switch (stmts.len) {
+            1 => stmts[0],
+            0 => switch (tree.nodeTag(loop.ast.then_expr)) {
+                .block, .block_semicolon, .block_two, .block_two_semicolon => return null,
+                else => loop.ast.then_expr,
+            },
+            else => return null,
+        };
+
+        // Gate the body's shape before the counter query, which is the only
+        // cache-backed work this walk does: a body that is neither the
+        // filling assignment nor a single nested `for` cannot be a full
+        // fill whatever its counters say, and most loops never get that
+        // far.  `levels[depth]` is still filled before either consumer
+        // recurses or reads it.
+        const tag = tree.nodeTag(stmt);
+        switch (tag) {
+            .for_simple, .@"for", .assign => {},
+            else => return null,
+        }
+        levels[depth] = self.forCounterLevel(loop) orelse return null;
+        switch (tag) {
+            .for_simple, .@"for" => return self.fullFillRoot(stmt, levels, depth + 1),
+            .assign => {
+                const pair = tree.nodeData(stmt).node_and_node;
+                if (self.rhsIsNotAValue(pair[1])) return null;
+                return self.fullFillAssignTarget(pair[0], levels, depth + 1);
+            },
+            else => unreachable,
+        }
+    }
+
+    /// The root local `lhs = …` fully initialises, when its index chain
+    /// is exactly the established counters, and every dimension it
+    /// indexes is exactly as long as the counter that walks it.
+    /// `level_count` is the number of enclosing loops established so
+    /// far, which is also the chain's required length.
+    fn fullFillAssignTarget(
+        self: *Builder,
+        lhs: Ast.Node.Index,
+        levels: *const [max_fill_depth]FillLevel,
+        level_count: usize,
+    ) ?LocalId {
+        const tree = self.tree;
+        const cache = self.cache orelse return null;
+        if (level_count == 0 or level_count > max_fill_depth) return null;
+        // Index nodes are visited innermost-first. Each remaining array
+        // therefore matches levels[level_count - 1 - n], including the root.
+        var inner: [max_fill_depth]Ast.Node.Index = undefined;
+        var cur = lhs;
+        for (0..level_count) |n| {
+            if (tree.nodeTag(cur) != .array_access) return null;
+            const data = tree.nodeData(cur).node_and_node;
+            if (tree.nodeTag(data[1]) != .identifier) return null;
+            const level = levels[level_count - 1 - n];
+            if (!std.mem.eql(u8, tree.tokenSlice(tree.nodeMainToken(data[1])), level.counter)) return null;
+            cur = data[0];
+            inner[n] = cur;
+        }
+        // Nothing left over: the container is a plain local, not a field
+        // or an element of one.
+        if (tree.nodeTag(cur) != .identifier) return null;
+        const root = self.name_to_local.get(tree.tokenSlice(tree.nodeMainToken(cur))) orelse return null;
+        // Every dimension must be exactly as long as the counter that walks
+        // it.  `inner[level_count - 1]` is the root itself, so this covers
+        // dimension 0 with no separate case.
+        for (inner[0..level_count], 0..) |node, n| {
+            const len = cache.fixedArrayLenOf(node) orelse return null;
+            if (len != levels[level_count - 1 - n].len) return null;
+        }
+        return root;
+    }
