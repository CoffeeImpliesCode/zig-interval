+test "use_undefined: a for over a nonempty comptime array initialises every element" {
+    // The compile-time table idiom: a global `const` array whose length
+    // types the buffer, filled by `inline for (table, 0..) |v, i|` and
+    // returned whole.  Every element is written on every iteration, so a
+    // report here can only come from a path that runs zero iterations.
+    try expectFlowRulesWithZls(
+        \\const dims = [_]u32{ 4, 8 };
+        \\pub fn build() [dims.len]u32 {
+        \\    var arr: [dims.len]u32 = undefined;
+        \\    inline for (dims, 0..) |d, i| arr[i] = d;
+        \\    return arr;
+        \\}
+    , &.{});
+}
+
+test "use_undefined: nested for over nonempty comptime arrays initialise the whole matrix" {
+    // The same idiom one level down.  Both loops iterate nonempty global
+    // tables, so the inner write runs for every (di, oi) pair and the
+    // matrix is fully initialised when it is returned.
+    try expectFlowRulesWithZls(
+        \\const dims = [_]u32{ 4, 8 };
+        \\const ops = [_]u8{ 'a', 'b' };
+        \\const Row = struct { v: u32, n: u8 };
+        \\pub fn build() [dims.len][ops.len]Row {
+        \\    var arr: [dims.len][ops.len]Row = undefined;
+        \\    inline for (dims, 0..) |d, di| {
+        \\        inline for (ops, 0..) |op, oi| {
+        \\            arr[di][oi] = .{ .v = d, .n = op };
+        \\        }
+        \\    }
+        \\    return arr;
+        \\}
+    , &.{});
+}
+
+test "use_undefined: three nested for over unequal nonempty comptime arrays initialise the whole block" {
+    // Depth 3 with three DIFFERENT dimension lengths — 2, 3 and 4.  At
+    // depth 2 the two orderings a chain walk could pair each dimension
+    // with coincide, so a depth-2 test cannot tell them apart; here they
+    // do not, and every dimension has to be checked against the counter
+    // that actually walks it.
+    try expectFlowRulesWithZls(
+        \\const outer = [_]u8{ 1, 2 };
+        \\const middle = [_]u8{ 3, 4, 5 };
+        \\const inner = [_]u8{ 6, 7, 8, 9 };
+        \\const Cell = struct { v: u8 };
+        \\pub fn build() [outer.len][middle.len][inner.len]Cell {
+        \\    var arr: [outer.len][middle.len][inner.len]Cell = undefined;
+        \\    inline for (outer, 0..) |a, i| {
+        \\        inline for (middle, 0..) |b, j| {
+        \\            inline for (inner, 0..) |c, k| {
+        \\                arr[i][j][k] = .{ .v = a + b + c };
+        \\            }
+        \\        }
+        \\    }
+        \\    return arr;
+        \\}
+    , &.{});
+}
+
+test "use_undefined: the else of a fully filled for can read the buffer" {
+    // `else` runs on NORMAL COMPLETION — every iteration taken, no
+    // `break` — not only when the input turned out to be empty.  The
+    // read there is safe for the same reason the read after the loop is:
+    // the table is nonempty and every element was written.
+    try expectFlowRulesWithZls(
+        \\const dims = [_]u32{ 4, 8 };
+        \\pub fn build() [dims.len]u32 {
+        \\    var arr: [dims.len]u32 = undefined;
