+    /// True when `input` is a zero-based index range — the `0..N` or `0..`
+    /// that `for (xs, 0..)` uses to bind a counter.  A `for` input range is
+    /// a `.for_range` node carrying `lhs..rhs` / `lhs..` in
+    /// `node_and_opt_node`, NOT a `.slice`: `Ast.fullSlice` returns null for
+    /// it, which is why matching the wrong tag proves nothing at all.
+    fn isZeroBasedRange(self: *Builder, input: Ast.Node.Index) bool {
+        if (self.tree.nodeTag(input) != .for_range) return false;
+        const cache = self.cache orelse return false;
+        const lo = cache.comptimeIntValueOf(self.tree.nodeData(input).node_and_opt_node[0]) orelse return false;
+        return lo == 0;
+    }
+
+    /// How many values the index range at input position `k` takes: the
+    /// explicit end of `0..N`, or, for the open `0..` that `for (xs, 0..)`
+    /// writes, `prev_len` — the length this same walk has already read for
+    /// the input it was written next to, rather than reading it a second
+    /// time.  Null when that neighbour did not resolve, or was itself a
+    /// range.
+    fn forRangeLen(
+        self: *Builder,
+        loop: Ast.full.For,
+        k: usize,
+        prev_len: ?u64,
+    ) ?u64 {
+        const end = self.tree.nodeData(loop.ast.inputs[k]).node_and_opt_node[1].unwrap() orelse
+            return prev_len;
+        const cache = self.cache orelse return null;
+        return cache.comptimeIntValueOf(end);
+    }
+
+    /// The identifier `loop`'s `|a, b, c|` binds at position `want`, or
+    /// null when the payload is absent, ends first, or binds that
+    /// position by pointer (`|*x|`), which is not a counter.
+    ///
+    /// `payload_token` is COMPUTED, not validated: `fullForComponents`
+    /// sets it to `lastToken(last_input) + 3`, plus one more when a comma
+    /// follows that input.  With a payload that lands exactly on the
+    /// token after `|`, but `for (0..n)` has no `|`, and the same sum
+    /// then points past the whole statement.  Anchor it on a `|` and a
+    /// capture token here, before the scan, so a following statement's
+    /// identifier cannot be read as this loop's counter.
+    fn forPayloadCaptureName(self: *Builder, loop: Ast.full.For, want: usize) ?[]const u8 {
+        const tree = self.tree;
+        const tags = tree.tokens.items(.tag);
+        const open = loop.payload_token;
+        if (open == 0 or open >= tags.len or tags[open - 1] != .pipe) return null;
+        switch (tags[open]) {
+            .identifier, .asterisk => {},
+            else => return null,
+        }
+        var pt = open;
+        var pos: usize = 0;
+        var by_ptr = false;
+        while (pt < tags.len) : (pt += 1) {
+            switch (tags[pt]) {
+                .pipe => return null,
+                .asterisk => by_ptr = true,
+                .identifier => {
+                    const name = tree.tokenSlice(pt);
+                    if (pos == want) return if (by_ptr) null else name;
+                    pos += 1;
+                    by_ptr = false;
+                },
+                .comma => {},
+                else => {},
+            }
+        }
+        return null;
+    }
+
+    /// The counter `loop` binds its index range to, with the number of
+    /// values that counter takes, or null unless the loop has exactly
+    /// one zero-based index range and every input a known positive
+    /// compile-time length.
+    fn forCounterLevel(self: *Builder, loop: Ast.full.For) ?FillLevel {
+        var counter: ?[]const u8 = null;
+        for (loop.ast.inputs, 0..) |input, k| {
+            if (self.tree.nodeTag(input) != .for_range) continue;
+            if (counter != null) return null;
+            counter = self.forPayloadCaptureName(loop, k) orelse return null;
+        }
+        const name = counter orelse return null;
+        return .{ .counter = name, .len = self.forTripCount(loop) orelse return null };
+    }
+
+    /// How many times `loop` iterates.  Null unless every input has a
+    /// compile-time length and none is empty: a runtime-length input, an
+    /// input that does not resolve, or any zero-length input leaves the
+    /// empty outcome reachable and the proof unestablished.
+    fn forTripCount(self: *Builder, loop: Ast.full.For) ?u64 {
+        const cache = self.cache orelse return null;
+        if (loop.ast.inputs.len == 0) return null;
+        var trips: ?u64 = null;
+        // What this walk already read for the input BEFORE `k`, for an
+        // open `0..` to stand on.  Cleared across a range, so an open
+        // range still refuses a range neighbour the way it did when it
+        // looked that neighbour's length up itself.
+        var prev_len: ?u64 = null;
+        for (loop.ast.inputs, 0..) |input, k| {
+            const is_range = self.tree.nodeTag(input) == .for_range;
+            // An index range that is not zero-based (`1..3`) does not walk
+            // the dimension from zero, so the loop is refused outright
+            // rather than measured.
+            const len: u64 = if (is_range) blk: {
+                if (!self.isZeroBasedRange(input)) return null;
+                break :blk self.forRangeLen(loop, k, prev_len) orelse return null;
+            } else cache.fixedArrayLenOf(input) orelse return null;
+            if (len == 0) return null;
+            prev_len = if (is_range) null else len;
+            trips = if (trips) |t| @min(t, len) else len;
+        }
+        return trips;
+    }
+
+    /// True when `node`, a fill's VALUE, cannot be a value at all.  Two
+    /// ways that happens, both of which make "the body is one assignment"
+    /// a false promise that the write happened:
+    ///
+    ///   - `undefined`, directly or as a struct-literal field.  That writes
+    ///     no initialised data, so the element is exactly as undefined as
+    ///     it was.
+    ///   - `break`, `continue` or `return` anywhere in the value.  The body
+    ///     still parses as a single assignment, and
+    ///     `arr[i] = if (skip) continue else v;` is valid Zig, but on the
+    ///     skipping path the assignment never executes at all.
+    ///
+    /// A token walk, in the shape of `destructorHasSelfUndefined`, and
+    /// conservative in that same direction: any of these tokens anywhere in
+    /// the value refuses the proof.  It is not a value model and it does not
+    /// try to be — it never asks what a callee does to the array.
+    fn rhsIsNotAValue(self: *Builder, node: Ast.Node.Index) bool {
+        const tree = self.tree;
+        const tags = tree.tokens.items(.tag);
+        const last = tree.lastToken(node);
+        var t = tree.firstToken(node);
+        while (t <= last) : (t += 1) {
+            switch (tags[t]) {
+                .identifier => {
+                    if (std.mem.eql(u8, tree.tokenSlice(t), "undefined")) return true;
+                },
+                .keyword_break, .keyword_continue, .keyword_return => return true,
+                else => {},
+            }
+        }
+        return false;
+    }
