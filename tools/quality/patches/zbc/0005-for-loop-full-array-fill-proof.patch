+/// `expectFlowRules` with the ZLS resolver attached, for the shapes whose
+/// correctness depends on resolved types — a `for` over a global table,
+/// where the proof that the table is nonempty needs the array's length.
+fn expectFlowRulesWithZls(source: []const u8, expected: []const []const u8) !void {
+    const gpa = std.testing.allocator;
+    var problems = try analyzeWithZls(gpa, source);
+    defer freeProblems(gpa, &problems);
+    try std.testing.expectEqual(expected.len, problems.items.len);
+    for (expected, problems.items) |rule, problem| try std.testing.expectEqualStrings(rule, problem.rule_id);
+}
+
+/// Which rules a source reports, without pinning how many times or in what
+/// order.  `reportWithNote` dedups by (byte offset, rule id), so a shape
+/// with two separate read sites of the same local is two problems, and
+/// whether the second one still fires depends on the shape under test.
+/// This states the rule SET exactly — every expected rule reported, and
+/// every reported rule expected — and leaves the count to the reading.
+fn expectRuleIdsWithZls(source: []const u8, expected: []const []const u8) !void {
+    const gpa = std.testing.allocator;
+    var problems = try analyzeWithZls(gpa, source);
+    defer freeProblems(gpa, &problems);
+    for (expected) |rule| {
+        var found = false;
+        for (problems.items) |problem| {
+            if (std.mem.eql(u8, problem.rule_id, rule)) found = true;
+        }
+        try std.testing.expect(found);
+    }
+    for (problems.items) |problem| {
+        var listed = false;
+        for (expected) |rule| {
+            if (std.mem.eql(u8, problem.rule_id, rule)) listed = true;
+        }
+        try std.testing.expect(listed);
+    }
+}
