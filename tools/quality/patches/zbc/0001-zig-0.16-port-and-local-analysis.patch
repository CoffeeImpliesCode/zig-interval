+
+fn importsStandardLibrary(tree: *const Ast) bool {
+    for (tree.rootDecls()) |node| {
+        const decl = tree.fullVarDecl(node) orelse continue;
+        if (!std.mem.eql(u8, tree.tokenSlice(decl.ast.mut_token + 1), "std")) continue;
