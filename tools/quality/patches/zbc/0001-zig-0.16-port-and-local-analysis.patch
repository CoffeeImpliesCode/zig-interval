+
+fn enclosingBodyStart(tree: *const Ast, anchor: Ast.TokenIndex) ?Ast.TokenIndex {
+    var result: ?Ast.TokenIndex = null;
+    for (tree.nodes.items(.tag), 0..) |tag, index| {
