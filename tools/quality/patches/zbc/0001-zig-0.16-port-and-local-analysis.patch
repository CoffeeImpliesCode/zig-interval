+/// is therefore the top of that lattice — "not established in this body" —
+/// and a call reaching such a pointer may write anything.
+fn resolveEscapePath(o: *Oracle, name: []const u8, at: Ast.TokenIndex) []const u8 {
+    if (!o.pointer_roots.contains(name)) return "";
+    var local = name;
+    for (0..8) |_| {
+        const path = latestEscapePath(o, local, at) orelse return "";
+        if (path.len == 0 or !o.pointer_roots.contains(path)) return path;
+        local = path;
+    }
+    return "";
+}
+
+/// Target bound by the last `local` binding strictly before `at`.
+fn latestEscapePath(o: *const Oracle, local: []const u8, at: Ast.TokenIndex) ?[]const u8 {
+    var latest: ?EscapeAlias = null;
+    for (o.escape_aliases.items) |entry| {
+        if (!std.mem.eql(u8, entry.local, local)) continue;
+        if (entry.token >= at) continue;
+        if (latest == null or entry.token > latest.?.token) latest = entry;
+    }
+    return if (latest) |entry| entry.path else null;
+}
+
+/// Is this pointer root a parameter of the analyzed function rather than one
+/// of its locals?  Only a local can hold a pointer this body established, so
+/// the two need different treatment when its target is unknown.
+fn isParameterRoot(o: *const Oracle, name: []const u8) bool {
+    for (o.locals) |binding| {
+        if (!std.mem.eql(u8, binding.name, name)) continue;
+        return binding.origin == .param;
+    }
+    return false;
+}
+
+/// Lexical test for a declared pointer type: `*T`, `**T`, `[*]T`, `[*c]T` and
+/// their `?`-optional forms.  A `*` that starts a pointer always lexes as
+/// `.asterisk` — inside `[*c]T` and `[*]T` as much as in a bare `*T` — with
+/// one exception: `**` is the single token `.asterisk_asterisk`.
+fn spellingIsPointer(tree: *const Ast, type_node: Ast.Node.Index) bool {
+    const tags = tree.tokens.items(.tag);
+    var token = tree.firstToken(type_node);
+    const last = tree.lastToken(type_node);
+    while (token <= last) : (token += 1) {
+        switch (tags[token]) {
+            .asterisk, .asterisk_asterisk => return true,
+            else => {},
+        }
+    }
+    return false;
+}
+
+fn localScalarSurvivesCall(o: *const Oracle, name: []const u8) bool {
+    if (std.mem.indexOfScalar(u8, name, '.') != null or o.addressed.contains(name)) return false;
+    for (o.locals) |binding| if (std.mem.eql(u8, binding.name, name)) return true;
+    return false;
+}
+
+fn isLocalName(o: *const Oracle, name: []const u8) bool {
+    for (o.locals) |binding| if (std.mem.eql(u8, binding.name, name)) return true;
+    return false;
+}
+
+/// A container path keeps its recorded length across a call when the root is a
+/// by-value local whose address never escapes: the callee receives a copy of
+/// the slice header, so nothing it does can resize the local.
+///
+/// `indirection_roots` is the exclusion list, and being on it is exactly the
+/// reason a root is NOT call-stable: a root there holds an ADDRESS, so
+/// `root.field` / `root.len` is a load through storage the callee may hold a
+/// pointer to.  A slice-typed root is absent from it on purpose — its header
+/// (`len`, `ptr`) is part of the local's own frame slot and no callee can
+/// write that slot without the address having escaped, which `addressed`
+/// already disqualifies.  `pointer_roots` still holds it for the escape model
+/// (`pathEscapedBy`), so a call that is actually handed the slice still drops
+/// the fact.
+fn callStableRoot(o: *const Oracle, root: []const u8) bool {
+    if (root.len == 0) return false;
+    if (std.mem.indexOfScalar(u8, root, '.') != null) return false;
+    if (o.addressed.contains(root) or o.indirection_roots.contains(root)) return false;
+    return isLocalName(o, root);
+}
+
+/// A scalar fact on a FIELD path (`self.active_frames`) survives a call when
+/// the callee cannot reach that field: its arguments and receiver name no
+/// overlapping storage.  This is the same "the address must escape" rule
+/// `localScalarSurvivesCall` applies to a bare local, refined from the root to
+/// the field.
+fn scalarSurvivesCall(o: *Oracle, name: []const u8, effect: ?Ast.Node.Index) bool {
+    if (std.mem.indexOfScalar(u8, name, '.') == null) return localScalarSurvivesCall(o, name);
+    if (!isLocalName(o, rootText(name))) return false;
+    const node = effect orelse return false;
+    return !pathEscapedBy(o, node, name);
+}
+
+fn containerSurvivesCall(o: *Oracle, path: []const u8, effect: ?Ast.Node.Index) bool {
+    const node = effect orelse return false;
+    if (!callStableRoot(o, rootText(path))) return false;
+    return !pathEscapedBy(o, node, path);
+}
+
+fn productFactorSurvives(o: *Oracle, factor: ProductFactor, effect: ?Ast.Node.Index) bool {
+    if (factor.is_container) return containerSurvivesCall(o, factor.key, effect);
+    return scalarSurvivesCall(o, factor.key, effect);
+}
+
+/// True when a call at `effect` can hand the callee storage that `path` names.
+/// `false` is only returned for effects we can enumerate completely: an
+/// ordinary call (receiver + arguments) or the writing argument of a
+/// `@memcpy`/`@memset`.  Anything else is treated as reaching everything.
+fn pathEscapedBy(o: *Oracle, effect: Ast.Node.Index, path: []const u8) bool {
+    const tree = o.tree;
+    var call_buffer: [1]Ast.Node.Index = undefined;
+    if (tree.fullCall(&call_buffer, effect)) |call| {
+        if (tree.nodeTag(call.ast.fn_expr) == .field_access) {
+            const receiver = tree.nodeData(call.ast.fn_expr).node_and_token[0];
+            // Zig binds `recv.method(...)` as `method(&recv, ...)` whenever the
+            // method takes a pointer receiver, so the receiver's own storage is
+            // writable even though no address appears in the source.
+            if (isPureFieldPath(tree, receiver) and
+                pathSegmentsOverlap(nodeSrc(tree, receiver), path)) return true;
+            if (escapeReaches(o, receiver, path)) return true;
+        }
+        for (call.ast.params) |param| if (escapeReaches(o, param, path)) return true;
+        return false;
+    }
+    var builtin_buffer: [2]Ast.Node.Index = undefined;
+    if (tree.builtinCallParams(&builtin_buffer, effect)) |params| {
+        const name = tree.tokenSlice(tree.nodeMainToken(effect));
+        // Only the destination of a copy/set is written; the sources are read.
+        if (params.len != 0 and (std.mem.eql(u8, name, "@memcpy") or std.mem.eql(u8, name, "@memset")))
+            return escapeReaches(o, params[0], path);
+        return true;
+    }
+    return true;
+}
+
+/// Does this argument hand the callee storage overlapping `path`?  A `&x`
+/// argument names its write target directly; a bare pointer variable names
+/// whatever it was pointed at; every other argument is a copy.
+fn escapeReaches(o: *Oracle, operand: Ast.Node.Index, path: []const u8) bool {
+    const tree = o.tree;
+    const arg = unwrapGrouped(tree, operand);
+    switch (tree.nodeTag(arg)) {
+        .address_of => return pathSegmentsOverlap(
+            nodeSrc(tree, unwrapGrouped(tree, tree.nodeData(arg).node)),
+            path,
+        ),
+        .identifier => {
+            const name = tree.tokenSlice(tree.nodeMainToken(arg));
+            if (!o.pointer_roots.contains(name)) return false;
+            const target = resolveEscapePath(o, name, tree.firstToken(arg));
+            if (target.len != 0) return pathSegmentsOverlap(target, path);
+            // No binding in this body establishes what this pointer names.  A
+            // parameter pointer was aimed at storage that already existed
+            // when the frame was created, so it can only reach a local of
+            // this body if this body took that local's address — and such a
+            // root is dropped outright by `addressed`, never consulted here.
+            // A pointer LOCAL may name anything, so let the call reach
+            // everything rather than guess.
+            if (isParameterRoot(o, name)) return o.addressed.contains(rootText(path));
+            return true;
+        },
+        // `p.*`, `p[i]`, `p.field` all read through a copy.
+        else => return false,
+    }
+}
+
+/// Leading identifier of a source-spelled path (`self` from `self.items[0]`).
+fn rootText(path: []const u8) []const u8 {
+    var end: usize = 0;
+    while (end < path.len and path[end] != '.' and path[end] != '[') : (end += 1) {}
+    return path[0..end];
+}
+
+/// True when two paths can name the same storage: one is a segment-wise
+/// prefix of the other (`self.frames` vs `self.frames.items[2]`).
+fn pathSegmentsOverlap(a: []const u8, b: []const u8) bool {
+    const left = rootText(a);
+    const right = rootText(b);
+    var i: usize = 0;
+    var j: usize = 0;
+    while (true) {
+        const l = nextSegment(left, &i) orelse return true;
+        const r = nextSegment(right, &j) orelse return true;
+        if (!std.mem.eql(u8, l, r)) return false;
+    }
+}
+
+fn nextSegment(path: []const u8, cursor: *usize) ?[]const u8 {
+    if (cursor.* >= path.len) return null;
+    var end = cursor.*;
+    while (end < path.len and path[end] != '.') : (end += 1) {}
+    const segment = path[cursor.*..end];
+    cursor.* = if (end < path.len) end + 1 else end;
+    return segment;
+}
+
+/// Invalidate the facts reachable from the call at `effect`.  `effect` is
+/// null when the effects are unknown, which drops every container, alias and
+/// product fact; a known call keeps the ones its arguments cannot reach.
+fn dropIndirectFacts(o: *Oracle, st: *State, effect: ?Ast.Node.Index) void {
+    for (o.addressed.keys.items) |root| {
+        dropContainersRootedAt(st, root);
+        st.dropScalarValsByName(root);
+        st.dropDiffAliasesByName(root);
+    }
+    var scalar: usize = 0;
+    while (scalar < st.scalars.keys.items.len) {
+        if (!scalarSurvivesCall(o, st.scalars.keys.items[scalar], effect)) {
+            const removed = st.scalars.keys.swapRemove(scalar);
+            std.debug.assert(!scalarSurvivesCall(o, removed, effect));
+        } else scalar += 1;
+    }
+    var bound: usize = 0;
+    while (bound < st.scalar_mins.items.len) {
+        if (!scalarSurvivesCall(o, st.scalar_mins.items[bound].name, effect)) {
+            const removed = st.scalar_mins.swapRemove(bound);
+            std.debug.assert(!scalarSurvivesCall(o, removed.name, effect));
+        } else bound += 1;
+    }
+    var numeric: usize = 0;
+    while (numeric < st.numeric.items.len) {
+        if (!scalarSurvivesCall(o, st.numeric.items[numeric].name, effect)) {
+            const removed = st.numeric.swapRemove(numeric);
+            std.debug.assert(!scalarSurvivesCall(o, removed.name, effect));
+        } else numeric += 1;
+    }
+    var scalar_value: usize = 0;
+    while (scalar_value < st.scalar_vals.items.len) {
+        if (!scalarSurvivesCall(o, st.scalar_vals.items[scalar_value].name, effect)) {
+            const removed = st.scalar_vals.swapRemove(scalar_value);
+            std.debug.assert(!scalarSurvivesCall(o, removed.name, effect));
+        } else scalar_value += 1;
+    }
+    var container: usize = 0;
+    while (container < st.containers.keys.items.len) {
+        if (!containerSurvivesCall(o, st.containers.keys.items[container], effect)) {
+            _ = st.containers.keys.swapRemove(container);
+        } else container += 1;
+    }
+    var min_len: usize = 0;
+    while (min_len < st.min_lens.items.len) {
+        if (!containerSurvivesCall(o, st.min_lens.items[min_len].path, effect)) {
+            _ = st.min_lens.swapRemove(min_len);
+        } else min_len += 1;
+    }
+    var alias: usize = 0;
+    while (alias < st.aliases.items.len) {
+        const entry = st.aliases.items[alias];
+        if (!containerSurvivesCall(o, entry.container, effect) or
+            !scalarSurvivesCall(o, entry.scalar, effect))
+        {
+            _ = st.aliases.swapRemove(alias);
+        } else alias += 1;
+    }
+    var product: usize = 0;
+    while (product < st.product_aliases.items.len) {
+        const entry = st.product_aliases.items[product];
+        if (!scalarSurvivesCall(o, entry.result, effect) or
+            !productFactorSurvives(o, entry.left, effect) or
+            !productFactorSurvives(o, entry.right, effect))
+        {
+            _ = st.product_aliases.swapRemove(product);
+        } else product += 1;
+    }
+    st.diff_aliases.clearRetainingCapacity();
+    st.value_aliases.clearRetainingCapacity();
+    st.bit_aliases.clearRetainingCapacity();
+    st.clearPredicates();
+}
+
+fn analyzeNode(o: *Oracle, node: Ast.Node.Index, st: *State) error{OutOfMemory}!Flow {
+    if (o.walk_depth == 64) {
+        o.budget = 0;
+        return .{};
+    }
+    o.walk_depth += 1;
+    defer o.walk_depth -= 1;
+    if (!o.spend()) return .{};
+    const tree = o.tree;
+    switch (tree.nodeTag(node)) {
+        .block, .block_semicolon, .block_two, .block_two_semicolon => {
+            var buf: [2]Ast.Node.Index = undefined;
+            return analyzeSeq(o, blockStmts(tree, node, &buf), st);
+        },
+        .@"if", .if_simple => return analyzeIf(o, node, st),
+        .@"switch", .switch_comma => return analyzeSwitch(o, node, st),
+        .@"while", .while_simple, .while_cont => return analyzeLoop(o, node, st, .while_),
+        .@"for", .for_simple => return analyzeLoop(o, node, st, .for_),
+        .simple_var_decl, .local_var_decl, .aligned_var_decl => return analyzeVarDecl(o, node, st),
+        .assign => return analyzeAssign(o, node, st),
+        .assign_destructure => {
+            const rhs = tree.nodeData(node).extra_and_node[1];
+            const flow = try analyzeNode(o, rhs, st);
+            if (o.tokenInNode(rhs) and flow.answer != null) return flow;
+            st.deinit(o.gpa);
+            st.* = .{};
+            return if (o.tokenInNode(node)) .{ .answer = o.answerAt(st) } else .{};
+        },
+        .assign_add => return analyzeCompoundAdd(o, node, st),
+        .assign_mul,
+        .assign_div,
+        .assign_mod,
+        .assign_sub,
+        .assign_shl,
+        .assign_shl_sat,
+        .assign_shr,
+        .assign_bit_and,
+        .assign_bit_xor,
+        .assign_bit_or,
+        .assign_mul_wrap,
+        .assign_add_wrap,
+        .assign_sub_wrap,
+        .assign_mul_sat,
+        .assign_add_sat,
+        .assign_sub_sat,
+        => return analyzeCompoundMutation(o, node, st),
+        // canonical guarded last-element idioms `c.len > 0 and c[c.len-1]` and
+        // `c.len == 0 or c[c.len-1]` (endsWith/startsWith), where the bounds
+        // proof lives in the same expression rather than an enclosing `if`.
+        .bool_and => return analyzeShortCircuit(o, node, st, true),
+        .bool_or => return analyzeShortCircuit(o, node, st, false),
+        .call, .call_comma, .call_one, .call_one_comma => return analyzeCall(o, node, st),
+        .@"return", .@"break", .@"continue", .unreachable_literal => {
+            if (tree.nodeTag(node) == .@"break") {
+                if (o.break_capture) |capture| {
+                    if (tree.nodeData(node).opt_token_and_opt_node[0].unwrap() != null) {
+                        capture.has_unresolved_target = true;
+                    } else {
+                        try capture.record(st);
+                    }
+                }
+            }
+            var flow: Flow = .{ .diverged = true };
+            // Descend into a `return <expr>;` operand so short-circuit
+            // refinement (bool_and/bool_or) applies before answering.
+            const operand: ?Ast.Node.Index = if (tree.nodeTag(node) == .@"return")
+                tree.nodeData(node).opt_node.unwrap()
+            else
+                null;
+            if (operand) |expression| if (o.predicate_capture) |capture| try capture.record(o, expression, st);
+            if (o.tokenInNode(node)) {
+                if (operand) |e| {
+                    const sub = try analyzeNode(o, e, st);
+                    flow.answer = sub.answer orelse o.answerAt(st);
+                } else flow.answer = o.answerAt(st);
+            }
+            return flow;
+        },
+        .fn_decl, .container_decl, .container_decl_trailing, .container_decl_two, .container_decl_two_trailing, .container_decl_arg, .container_decl_arg_trailing, .@"comptime" => return .{},
+        .@"catch", .@"orelse" => {
+            // The right operand runs only when the left one failed, so a use
+            // inside it is analyzed on its own path: its own guards must be
+            // seen, and the left operand's success facts must NOT be assumed.
+            const data = tree.nodeData(node).node_and_node;
+            if (o.tokenInNode(data[1])) {
+                dropLoopMutated(o, node, st);
+                dropIndirectFacts(o, st, data[0]);
+                return try analyzeNode(o, data[1], st);
+            }
+            dropLoopMutated(o, node, st);
+            dropIndirectFacts(o, st, null);
+            return if (o.tokenInNode(node)) .{ .answer = o.answerAt(st) } else .{};
+        },
+        .@"defer" => {
+            dropLoopMutated(o, node, st);
+            dropIndirectFacts(o, st, tree.nodeData(node).node);
+            return if (o.tokenInNode(node)) .{ .answer = o.answerAt(st) } else .{};
+        },
+        .@"errdefer" => {
+            dropLoopMutated(o, node, st);
+            dropIndirectFacts(o, st, tree.nodeData(node).opt_token_and_node[1]);
+            return if (o.tokenInNode(node)) .{ .answer = o.answerAt(st) } else .{};
+        },
+        else => return analyzeExpression(o, node, st),
+    }
+}
+
+fn analyzeExpression(o: *Oracle, node: Ast.Node.Index, st: *State) error{OutOfMemory}!Flow {
+    const tree = o.tree;
+    if (tree.nodeTag(node) == .builtin_call or tree.nodeTag(node) == .builtin_call_two or
+        tree.nodeTag(node) == .builtin_call_comma or tree.nodeTag(node) == .builtin_call_two_comma)
+    {
+        const name = tree.tokenSlice(tree.nodeMainToken(node));
+        if (std.mem.eql(u8, name, "@TypeOf")) return .{};
+    }
+    var children = @import("type_engine").AstIterator.init(tree, node);
+    while (children.next(tree)) |child| {
+        const flow = try analyzeNode(o, child, st);
+        if (o.tokenInNode(child) and flow.answer != null) return flow;
+    }
+    if (mayMutateIndirect(o, node)) dropIndirectFacts(o, st, node);
+    if (o.tokenInNode(node)) return .{ .answer = o.answerAt(st) };
+    killMutatedContainers(o, node, st);
+    try recordReadBounds(o, node, st);
+    return .{};
+}
+
+/// A dominating read `c[i]` bounds `c` from below: for a slice the index is
+/// checked against `.len`, so reaching the statement means `i < c.len`.  That
+/// only carries a length fact when the receiver is a container whose own type
+/// bounds the index — a slice or a fixed-size array.  A C pointer (`[*c]T`),
+/// a many-pointer (`[*]T`) or a single pointer (`*T`) has no `.len` at all, so
+/// indexing one proves nothing about any length.
+fn recordReadBounds(o: *Oracle, node: Ast.Node.Index, st: *State) error{OutOfMemory}!void {
+    const tree = o.tree;
+    var container: Ast.Node.Index = undefined;
+    var minimum: u64 = 0;
+    if (tree.nodeTag(node) == .array_access) {
+        const parts = tree.nodeData(node).node_and_node;
+        container = parts[0];
+        const index = exprMin(o, st, parts[1]) orelse 0;
+        minimum = std.math.add(u64, index, 1) catch return;
+    } else if (tree.fullSlice(node)) |slice| {
+        container = slice.ast.sliced;
+        minimum = exprMin(o, st, slice.ast.start) orelse return;
+    } else return;
+    if (minimum == 0 or !isPureFieldPath(tree, container)) return;
+    if (!isLengthBoundedReceiver(o, container)) return;
+    try applyRefineFacts(o, st, null, 0, nodeSrc(tree, container), minimum, null);
+}
+
+/// Is `receiver` a value whose own length bounds every index into it?
+fn isLengthBoundedReceiver(o: *Oracle, receiver: Ast.Node.Index) bool {
+    const tree = o.tree;
+    const declared = declaredTypeOf(o, rootText(nodeSrc(tree, receiver)), tree.firstToken(receiver)) orelse
+        return false;
+    return declaredTypeIsBounded(tree, declared);
+}
+
+/// The written type `name` has at the use at `at` — a parameter's type
+/// annotation or an annotated `const`/`var`.  A parameter is visible for the
+/// whole body; a local only from its own declaration to the end of its block,
+/// so the lookup walks the blocks enclosing `at` from the innermost outward.
+/// A same-named binding in a sibling block is a different value with a
+/// different type and must not supply one.  Lexical on purpose: queries reach
+/// this oracle without the type engine (the `.ptr[0..N]` rule passes a null
+/// cache), so the proof must not depend on one.
+fn declaredTypeOf(o: *Oracle, name: []const u8, at: Ast.TokenIndex) ?Ast.Node.Index {
+    const tree = o.tree;
+    const declaration = enclosingFnDecl(o) orelse return null;
+    var buffer: [1]Ast.Node.Index = undefined;
+    const proto = tokens.fnProto(tree, &buffer, declaration) orelse return null;
+    var params = proto.iterate(tree);
+    while (params.next()) |param| {
+        const name_token = param.name_token orelse continue;
+        if (!std.mem.eql(u8, tree.tokenSlice(name_token), name)) continue;
+        return param.type_expr;
+    }
+    var scope: [16]Ast.Node.Index = undefined;
+    const depth = enclosingBlocks(tree, at, &scope);
+    var statements: [2]Ast.Node.Index = undefined;
+    for (scope[0..depth]) |block| {
+        for (blockStmts(tree, block, &statements)) |statement| {
+            if (tree.firstToken(statement) > at) break;
+            switch (tree.nodeTag(statement)) {
+                .simple_var_decl, .local_var_decl, .aligned_var_decl => {},
+                else => continue,
+            }
+            const decl = tree.fullVarDecl(statement) orelse continue;
+            if (!std.mem.eql(u8, tree.tokenSlice(decl.ast.mut_token + 1), name)) continue;
+            return decl.ast.type_node.unwrap();
+        }
+    }
+    return null;
+}
+
+/// Blocks whose tokens contain `at`, innermost first, and how many were
+/// found.  Nesting deeper than `scope.len` leaves the outer blocks unvisited:
+/// a binding found only there stays unresolved, which costs a proof but never
+/// takes a wrong one.
+fn enclosingBlocks(
+    tree: *const Ast,
+    at: Ast.TokenIndex,
+    scope: *[16]Ast.Node.Index,
+) usize {
+    var len: usize = 0;
+    for (tree.nodes.items(.tag), 0..) |tag, index| {
+        switch (tag) {
+            .block, .block_semicolon, .block_two, .block_two_semicolon => {},
+            else => continue,
+        }
+        const node: Ast.Node.Index = @enumFromInt(index);
+        if (tree.firstToken(node) > at or tree.lastToken(node) < at) continue;
+        // Keep the order by first token descending: nested blocks open later.
+        var position: usize = 0;
+        while (position < len and tree.firstToken(scope[position]) > tree.firstToken(node)) : (position += 1) {}
+        if (position == len) {
+            if (len == scope.len) break;
+            len += 1;
+        } else {
+            var shift = len;
+            while (shift > position) : (shift -= 1) scope[shift] = scope[shift - 1];
+        }
+        scope[position] = node;
+    }
+    return len;
+}
+
+/// The `fn_decl` whose body the oracle analyzes, or null for a synthetic body.
