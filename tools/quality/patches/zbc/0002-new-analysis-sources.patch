+//! Bounded numeric expression evaluation over resolved types and path facts.
+const std = @import("std");
+const Ast = std.zig.Ast;
+const numbers = @import("numeric_range.zig");
+const FileCache = @import("../cache/file_cache.zig").FileCache;
+const Range = numbers.Range;
+
+pub const Fact = struct { name: []const u8, value: Range };
+
+pub const Evaluator = struct {
+    tree: *const Ast,
+    cache: ?*FileCache,
+    facts: []const Fact,
+    budget: *u32,
+    std_valid: bool,
+    depth: u8 = 0,
+
+    pub fn evaluate(self: *Evaluator, original: Ast.Node.Index) Range {
+        if (self.depth == 64 or self.budget.* == 0) {
+            self.budget.* = 0;
+            return .unknown;
+        }
+        self.budget.* -= 1;
+        self.depth += 1;
+        defer self.depth -= 1;
+        const node = ungroup(self.tree, original);
+        if (path(self.tree, node)) |name| {
+            for (self.facts) |fact| {
+                if (std.mem.eql(u8, fact.name, name)) return fact.value;
+            }
+        }
+        return switch (self.tree.nodeTag(node)) {
+            .number_literal => self.literal(node),
+            .negation => self.evaluate(self.tree.nodeData(node).node).negate(),
+            .identifier, .field_access, .deref => self.binding(node),
+            .@"try" => self.evaluate(self.tree.nodeData(node).node),
+            .add, .sub, .mul, .div => self.arithmetic(node),
+            .bit_and, .bit_or, .bit_xor => self.bitwise(node),
+            .shl, .shr => self.shift(node),
+            .builtin_call, .builtin_call_comma, .builtin_call_two, .builtin_call_two_comma => self.builtinCall(node),
+            .call, .call_comma, .call_one, .call_one_comma => self.standardCall(node),
+            else => self.typeRange(node),
+        };
+    }
+
+    pub fn typeRange(self: *Evaluator, node: Ast.Node.Index) Range {
+        const cache = self.cache orelse return .unknown;
+        if (cache.intInfoOf(node)) |info| return Range.integerType(info.bits, info.signed);
+        if (cache.isFloatType(node) == true) return .{ .floating = .{} };
+        return .unknown;
+    }
+
+    pub fn floatBits(self: *Evaluator, node: Ast.Node.Index) ?u16 {
+        const cache = self.cache orelse return null;
+        const resolver = cache.zls orelse return null;
+        return resolver.floatBits(node) catch null;
+    }
+
+    pub fn coerce(self: *Evaluator, value: Range, source: Ast.Node.Index, destination: Ast.Node.Index) Range {
+        if (self.floatBits(destination)) |bits| {
+            if (self.floatBits(source)) |source_bits| {
+                if (source_bits <= bits and value == .floating) return value;
+            }
+            return value.asFloat(bits);
+        }
+        const target = self.typeRange(destination);
+        if (target == .integer) return value.intersect(target);
+        return value;
+    }
+
+    fn literal(self: *Evaluator, node: Ast.Node.Index) Range {
+        const text = self.tree.tokenSlice(self.tree.nodeMainToken(node));
+        return switch (std.zig.parseNumberLiteral(text)) {
+            .int, .big_int => Range.constant(std.fmt.parseInt(i128, text, 0) catch return .unknown),
+            .float => Range.floatConstant(std.fmt.parseFloat(f128, text) catch return .unknown)
+                .asFloat(self.floatBits(node) orelse 128),
+            .failure => .unknown,
+        };
+    }
+
+    fn binding(self: *Evaluator, node: Ast.Node.Index) Range {
+        if (self.tree.nodeTag(node) == .field_access) {
+            const parts = self.tree.nodeData(node).node_and_token;
+            if (std.mem.eql(u8, self.tree.tokenSlice(parts[1]), "len")) {
+                if (self.cache) |cache| {
+                    if (cache.fixedArrayLenOf(parts[0])) |length| return Range.constant(length);
+                }
+            }
+        }
+        if (self.cache) |cache| {
+            if (cache.comptimeIntValueOf(node)) |value| return Range.constant(value);
+        }
+        return self.typeRange(node);
+    }
+
+    fn arithmetic(self: *Evaluator, node: Ast.Node.Index) Range {
+        const parts = self.tree.nodeData(node).node_and_node;
+        var left = self.evaluate(parts[0]);
+        var right = self.evaluate(parts[1]);
+        const precision = self.floatBits(node);
+        if (left == .floating or right == .floating) {
+            const bits = precision orelse return .{ .floating = .{} };
+            left = left.asFloat(bits);
+            right = right.asFloat(bits);
+        }
+        const op: numbers.Operation = switch (self.tree.nodeTag(node)) {
+            .add => .add,
+            .sub => .sub,
+            .mul => .mul,
+            .div => .div,
+            else => unreachable,
+        };
+        const value = left.binary(right, op);
+        if (value == .floating) return value.asFloat(precision orelse 0);
+        return value;
+    }
+
+    fn bitwise(self: *Evaluator, node: Ast.Node.Index) Range {
+        const parts = self.tree.nodeData(node).node_and_node;
+        const left = self.evaluate(parts[0]);
+        const right = self.evaluate(parts[1]);
+        const tag = self.tree.nodeTag(node);
+        if (tag == .bit_and) {
+            if (right == .integer and right.integer.min >= 0) return .{ .integer = .{
+                .min = 0,
+                .max = if (left == .integer and left.integer.min >= 0)
+                    @min(left.integer.max, right.integer.max)
+                else
+                    right.integer.max,
+            } };
+            if (left == .integer and left.integer.min >= 0)
+                return .{ .integer = .{ .min = 0, .max = left.integer.max } };
+        }
+        if (left != .integer or right != .integer or left.integer.min < 0 or right.integer.min < 0)
+            return self.typeRange(node);
+        const largest: u128 = @intCast(@max(left.integer.max, right.integer.max));
+        const upper: i128 = if (largest == 0) 0 else @intCast(@as(u128, std.math.maxInt(u128)) >> @intCast(@clz(largest)));
+        return .{ .integer = .{
+            .min = if (tag == .bit_or) @max(left.integer.min, right.integer.min) else 0,
+            .max = upper,
+        } };
+    }
+
+    fn shift(self: *Evaluator, node: Ast.Node.Index) Range {
+        const parts = self.tree.nodeData(node).node_and_node;
+        const left = self.evaluate(parts[0]);
+        const right = self.evaluate(parts[1]);
+        if (left != .integer or right != .integer or right.integer.min < 0 or right.integer.max > 126)
+            return self.typeRange(node);
+        var low: i128 = std.math.maxInt(i128);
+        var high: i128 = std.math.minInt(i128);
+        for ([_]i128{ left.integer.min, left.integer.max }) |value| {
+            for ([_]i128{ right.integer.min, right.integer.max }) |count| {
+                const amount: u7 = @intCast(count);
+                const shifted = if (self.tree.nodeTag(node) == .shr) value >> amount else std.math.mul(i128, value, @as(i128, 1) << amount) catch return self.typeRange(node);
+                low = @min(low, shifted);
+                high = @max(high, shifted);
+            }
+        }
+        if (self.tree.nodeTag(node) == .shl) {
+            const destination = self.typeRange(node);
+            if (destination == .integer) {
+                if (low < destination.integer.min or high > destination.integer.max) return destination;
+            } else if (self.tree.nodeTag(parts[0]) != .number_literal or self.tree.nodeTag(parts[1]) != .number_literal)
+                return .unknown;
+        }
+        return .{ .integer = .{ .min = low, .max = high } };
+    }
+
+    fn builtinCall(self: *Evaluator, node: Ast.Node.Index) Range {
+        var buffer: [2]Ast.Node.Index = undefined;
+        const params = self.tree.builtinCallParams(&buffer, node) orelse return .unknown;
+        const name = self.tree.tokenSlice(self.tree.nodeMainToken(node));
+        if (std.mem.eql(u8, name, "@as") and params.len == 2)
+            return self.coerce(self.evaluate(params[1]), params[1], params[0]);
+        if (params.len == 1 and (std.mem.eql(u8, name, "@intCast") or std.mem.eql(u8, name, "@floatCast")))
+            return self.coerce(self.evaluate(params[0]), params[0], node);
+        if (params.len == 1 and std.mem.eql(u8, name, "@floatFromInt"))
+            return self.evaluate(params[0]).asFloat(self.floatBits(node) orelse 0);
+        if (params.len == 2 and (std.mem.eql(u8, name, "@min") or std.mem.eql(u8, name, "@max")))
+            return self.minimumMaximum(node, params[0], params[1], std.mem.eql(u8, name, "@min"));
+        if (params.len == 2 and std.mem.eql(u8, name, "@divTrunc"))
+            return self.evaluate(params[0]).binary(self.evaluate(params[1]), .div);
+        if (params.len == 1 and (std.mem.eql(u8, name, "@clz") or std.mem.eql(u8, name, "@ctz") or
+            std.mem.eql(u8, name, "@popCount")))
+        {
+            if (self.cache) |cache| {
+                if (cache.intInfoOf(params[0])) |info| return .{ .integer = .{ .min = 0, .max = info.bits } };
+            }
+        }
+        if (params.len == 1) return self.floatBuiltin(node, name, params[0]);
+        return self.typeRange(node);
+    }
+
+    fn minimumMaximum(self: *Evaluator, node: Ast.Node.Index, left: Ast.Node.Index, right: Ast.Node.Index, minimum: bool) Range {
+        var a = self.evaluate(left);
+        var b = self.evaluate(right);
+        if (a == .unknown or b == .unknown or a == .floating or b == .floating) {
+            const bits = self.floatBits(node) orelse return .unknown;
+            a = a.asFloat(bits);
+            b = b.asFloat(bits);
+        }
+        return a.binary(b, if (minimum) .minimum else .maximum);
+    }
+
+    fn floatBuiltin(self: *Evaluator, node: Ast.Node.Index, name: []const u8, operand: Ast.Node.Index) Range {
+        const value = self.evaluate(operand);
+        if (value != .floating) return self.typeRange(node);
+        var result = value.floating;
+        result.min_open = false;
+        result.max_open = false;
+        if (std.mem.eql(u8, name, "@abs")) {
+            const lower = @abs(result.min);
+            const upper = @abs(result.max);
+            result.min = if (result.min <= 0 and result.max >= 0) 0 else @min(lower, upper);
+            result.max = @max(lower, upper);
+        } else if (std.mem.eql(u8, name, "@sqrt")) {
+            result.no_nan = result.no_nan and result.min >= 0;
+            result.min = std.math.nextAfter(f128, @sqrt(@max(result.min, 0)), -std.math.inf(f128));
+            result.max = std.math.nextAfter(f128, @sqrt(@max(result.max, 0)), std.math.inf(f128));
+        } else if (std.mem.eql(u8, name, "@floor")) {
+            result.min = @floor(result.min);
+            result.max = @floor(result.max);
+        } else if (std.mem.eql(u8, name, "@ceil")) {
+            result.min = @ceil(result.min);
+            result.max = @ceil(result.max);
+        } else if (std.mem.eql(u8, name, "@trunc")) {
+            result.min = @trunc(result.min);
+            result.max = @trunc(result.max);
+        } else if (std.mem.eql(u8, name, "@round")) {
+            result.min = @round(result.min);
+            result.max = @round(result.max);
+        } else return self.typeRange(node);
+        return (Range{ .floating = result }).asFloat(self.floatBits(node) orelse 128);
+    }
+
+    fn standardCall(self: *Evaluator, node: Ast.Node.Index) Range {
+        if (!self.std_valid) return self.typeRange(node);
+        var buffer: [1]Ast.Node.Index = undefined;
+        const call = self.tree.fullCall(&buffer, node).?;
+        const name = path(self.tree, call.ast.fn_expr) orelse return self.typeRange(node);
+        const params = call.ast.params;
+        if (params.len == 1 and std.mem.eql(u8, name, "std.math.inf"))
+            return Range.floatConstant(std.math.inf(f128));
+        if (params.len == 1 and std.mem.eql(u8, name, "std.math.nan")) return .{ .floating = .{} };
+        if (params.len == 1 and (std.mem.eql(u8, name, "std.math.minInt") or std.mem.eql(u8, name, "std.math.maxInt"))) {
+            const target = self.typeRange(params[0]);
+            if (target != .integer) return .unknown;
+            return Range.constant(if (std.mem.eql(u8, name, "std.math.minInt")) target.integer.min else target.integer.max);
+        }
+        if (params.len == 3 and std.mem.eql(u8, name, "std.math.clamp")) {
+            const bits = self.floatBits(node) orelse return .unknown;
+            const value = self.evaluate(params[0]).asFloat(bits);
+            const lower = self.evaluate(params[1]).asFloat(bits);
+            const upper = self.evaluate(params[2]).asFloat(bits);
+            return value.binary(upper, .minimum).binary(lower, .maximum);
+        }
+        return self.typeRange(node);
+    }
+};
+
+pub fn path(tree: *const Ast, original: Ast.Node.Index) ?[]const u8 {
+    const node = ungroup(tree, original);
+    var part = node;
+    for (0..64) |_| {
+        switch (tree.nodeTag(part)) {
+            .identifier => {
+                const first = tree.firstToken(node);
+                const last = tree.lastToken(node);
+                return tree.source[tree.tokenStart(first) .. tree.tokenStart(last) + tree.tokenSlice(last).len];
+            },
+            .field_access => part = tree.nodeData(part).node_and_token[0],
+            .deref => part = tree.nodeData(part).node,
+            .grouped_expression => part = tree.nodeData(part).node_and_token[0],
+            else => return null,
+        }
+    }
+    return null;
+}
+
+fn ungroup(tree: *const Ast, original: Ast.Node.Index) Ast.Node.Index {
+    var node = original;
+    for (0..64) |_| {
+        if (tree.nodeTag(node) != .grouped_expression) return node;
+        node = tree.nodeData(node).node_and_token[0];
+    }
+    return node;
+}
+
+pub const Constraint = struct { node: Ast.Node.Index, value: Range };
+
+pub fn refine(evaluation: *Evaluator, original: Ast.Node.Index, truth: bool) [2]?Constraint {
+    const tree = evaluation.tree;
+    const node = ungroup(tree, original);
+    const tag = tree.nodeTag(node);
+    var call_buffer: [1]Ast.Node.Index = undefined;
+    if (tree.fullCall(&call_buffer, node)) |call| {
+        if (!evaluation.std_valid or call.ast.params.len != 1) return .{ null, null };
+        const name = path(tree, call.ast.fn_expr) orelse return .{ null, null };
+        var value = evaluation.evaluate(call.ast.params[0]);
+        if (value != .floating) value = .{ .floating = .{} };
+        if (std.mem.eql(u8, name, "std.math.isFinite") and truth) {
+            value.floating.no_nan = true;
+            if (std.math.isInf(value.floating.min)) value.floating.min_open = true;
+            if (std.math.isInf(value.floating.max)) value.floating.max_open = true;
+        } else if (std.mem.eql(u8, name, "std.math.isNan") and !truth) {
+            value.floating.no_nan = true;
+        } else return .{ null, null };
+        return .{ .{ .node = call.ast.params[0], .value = value }, null };
+    }
+    const op = comparison(tag, truth) orelse return .{ null, null };
+    const parts = tree.nodeData(node).node_and_node;
+    const left = evaluation.evaluate(parts[0]);
+    const right = evaluation.evaluate(parts[1]);
+    if (path(tree, parts[0])) |key| {
+        if (path(tree, parts[1])) |other| {
+            if (std.mem.eql(u8, key, other) and
+                ((tag == .equal_equal and truth) or (tag == .bang_equal and !truth)))
+            {
+                var value = left;
+                if (value == .unknown) value = .{ .floating = .{} };
+                if (value == .floating) value.floating.no_nan = true;
+                return .{ .{ .node = parts[0], .value = value }, null };
+            }
+        }
+    }
+    return .{
+        .{ .node = parts[0], .value = constrained(evaluation, parts[0], left, right, op, tag, truth) },
+        .{ .node = parts[1], .value = constrained(evaluation, parts[1], right, left, reverse(op), tag, truth) },
+    };
+}
+
+const Comparison = enum { lt, le, gt, ge, eq, ne };
+
+fn comparison(tag: Ast.Node.Tag, truth: bool) ?Comparison {
+    return switch (tag) {
+        .less_than => if (truth) .lt else .ge,
+        .less_or_equal => if (truth) .le else .gt,
+        .greater_than => if (truth) .gt else .le,
+        .greater_or_equal => if (truth) .ge else .lt,
+        .equal_equal => if (truth) .eq else .ne,
+        .bang_equal => if (truth) .ne else .eq,
+        else => null,
+    };
+}
+
+fn reverse(op: Comparison) Comparison {
+    return switch (op) {
+        .lt => .gt,
+        .le => .ge,
+        .gt => .lt,
+        .ge => .le,
+        .eq => .eq,
+        .ne => .ne,
+    };
+}
+
+fn constrained(
+    evaluation: *Evaluator,
+    node: Ast.Node.Index,
+    value: Range,
+    limit: Range,
+    op: Comparison,
+    tag: Ast.Node.Tag,
+    truth: bool,
+) Range {
+    if (value == .integer and limit == .integer) return constrainInteger(value.integer, limit.integer, op);
+    const bits = evaluation.floatBits(node) orelse 0;
+    const current = if (value == .floating) value.floating else value.asFloat(bits).floating;
+    const boundary = limit.asFloat(bits).floating;
+    const ordered = (truth and tag != .bang_equal) or (!truth and tag == .bang_equal);
+    return constrainFloat(current, boundary, op, ordered);
+}
+
+fn constrainInteger(original: numbers.Integer, limit: numbers.Integer, op: Comparison) Range {
+    var value = original;
+    switch (op) {
+        .lt => value.max = @min(value.max, std.math.sub(i128, limit.max, 1) catch return .unknown),
+        .le => value.max = @min(value.max, limit.max),
+        .gt => value.min = @max(value.min, std.math.add(i128, limit.min, 1) catch return .unknown),
+        .ge => value.min = @max(value.min, limit.min),
+        .eq => {
+            value.min = @max(value.min, limit.min);
+            value.max = @min(value.max, limit.max);
+        },
+        .ne => if (limit.min == limit.max) {
+            if (value.min == limit.min) value.min = std.math.add(i128, value.min, 1) catch return .unknown;
+            if (value.max == limit.max) value.max = std.math.sub(i128, value.max, 1) catch return .unknown;
+        },
+    }
+    if (value.min > value.max) return .unknown;
+    return .{ .integer = value };
+}
+
+fn constrainFloat(original: numbers.Floating, limit: numbers.Floating, op: Comparison, ordered: bool) Range {
+    if (!ordered and !limit.no_nan) return .{ .floating = original };
+    var value = original;
+    if (ordered) value.no_nan = true;
+    switch (op) {
+        .lt, .le => {
+            if (limit.max <= value.max) {
+                const open = (op == .lt) or limit.max_open;
+                value.max_open = open or (limit.max == value.max and value.max_open);
+                value.max = limit.max;
+            }
+        },
+        .gt, .ge => {
+            if (limit.min >= value.min) {
+                const open = (op == .gt) or limit.min_open;
+                value.min_open = open or (limit.min == value.min and value.min_open);
+                value.min = limit.min;
+            }
+        },
+        .eq => return (Range{ .floating = value }).intersect(.{ .floating = limit }),
+        .ne => if (limit.min == limit.max and limit.no_nan) {
+            if (value.min == limit.min) value.min_open = true;
+            if (value.max == limit.max) value.max_open = true;
+        },
+    }
+    if (value.min > value.max) return .unknown;
+    return .{ .floating = value };
+}
diff --git a/src/flow/numeric_range.zig b/src/flow/numeric_range.zig
new file mode 100644
index 0000000..069b9e8
--- /dev/null
+++ b/src/flow/numeric_range.zig
@@ -0,0 +1,400 @@
+//! Numeric intervals used by the forward range analysis.
+//! Integer operations are checked. Floating arithmetic rounds bounds outward.
+const std = @import("std");
+const inf = std.math.inf(f128);
+
+pub const Integer = struct {
+    min: i128,
+    max: i128,
+};
+
+pub const Floating = struct {
+    min: f128 = -inf,
+    max: f128 = inf,
+    min_open: bool = false,
+    max_open: bool = false,
+    no_nan: bool = false,
+
+    pub fn fitsInteger(self: Floating, bits: u16, signed: bool) bool {
+        if (!self.no_nan or bits > 128) return false;
+        const high = powerOfTwo(if (signed and bits > 0) bits - 1 else bits);
+        const low = if (signed and bits > 0) -high else 0;
+        // Truncation toward zero also admits the open unit interval below
+        // the minimum integer. Keep a conservative bound for wide integers.
+        const lower = if (bits <= 64) low - 1 else low;
+        const lower_ok = self.min > lower or (self.min == lower and
+            (self.min_open or bits > 64));
+        const upper_ok = self.max < high or (self.max == high and self.max_open);
+        return lower_ok and upper_ok;
+    }
+};
+
+/// Decode an upper bound on masked IEEE bits without assuming omitted bits are zero.
+pub fn ieeeFloatRange(width: u8, mask: u64, value: Range, absolute: bool) Range {
+    const infinity_bits: u64 = switch (width) {
+        16 => 0x7c00,
+        32 => 0x7f800000,
+        64 => 0x7ff0000000000000,
+        else => return .unknown,
+    };
+    if (value != .integer or value.integer.min < 0) return .unknown;
+    const sign = @as(u64, 1) << @as(u6, @intCast(width - 1));
+    const magnitude_mask = sign - 1;
+    const full_mask = sign | magnitude_mask;
+    if (mask & ~full_mask != 0 or value.integer.min > full_mask) return .unknown;
+    var maximum: u64 = @intCast(@min(value.integer.max, full_mask));
+    const minimum: u64 = @intCast(value.integer.min);
+    const positive = mask & sign != 0 and maximum < sign;
+    const negative = mask & sign != 0 and minimum >= sign;
+    if (mask & sign != 0 and !positive and !negative) return .unknown;
+    const forbidden = maximum & ~mask;
+    if (forbidden != 0) {
+        const bit = @as(u64, 1) << @as(u6, @intCast(63 - @clz(forbidden)));
+        const lower = bit - 1;
+        maximum = (maximum & ~(lower | bit)) | (mask & lower);
+    }
+    const magnitude = (maximum & magnitude_mask) | (~mask & magnitude_mask);
+    if (magnitude >= infinity_bits) return .unknown;
+    const upper: f128 = switch (width) {
+        16 => @floatCast(@as(f16, @bitCast(@as(u16, @intCast(magnitude))))),
+        32 => @floatCast(@as(f32, @bitCast(@as(u32, @intCast(magnitude))))),
+        64 => @floatCast(@as(f64, @bitCast(magnitude))),
+        else => unreachable,
+    };
+    return .{ .floating = .{
+        .min = if (positive and !absolute) 0 else -upper,
+        .max = if (negative and !absolute) 0 else upper,
+        .no_nan = true,
+    } };
+}
+
+pub const Operation = enum { add, sub, mul, div, minimum, maximum };
+
+pub const Range = union(enum) {
+    unknown,
+    integer: Integer,
+    floating: Floating,
+
+    pub fn constant(value: i128) Range {
+        return .{ .integer = .{ .min = value, .max = value } };
+    }
+
+    pub fn floatConstant(value: f128) Range {
+        if (std.math.isNan(value)) return .{ .floating = .{} };
+        return .{ .floating = .{ .min = value, .max = value, .no_nan = true } };
+    }
+
+    pub fn integerType(bits: u16, signed: bool) Range {
+        if (bits == 0) return constant(0);
+        if (bits > 128 or (!signed and bits == 128)) return .unknown;
+        if (bits == 128) return .{ .integer = .{
+            .min = std.math.minInt(i128),
+            .max = std.math.maxInt(i128),
+        } };
+        if (bits == 127 and !signed) return .{ .integer = .{
+            .min = 0,
+            .max = std.math.maxInt(i128),
+        } };
+        const shift: u7 = @intCast(if (signed) bits - 1 else bits);
+        const high = @as(i128, 1) << shift;
+        return .{ .integer = .{ .min = if (signed) -high else 0, .max = high - 1 } };
+    }
+
+    pub fn fitsInteger(self: Range, bits: u16, signed: bool) bool {
+        return switch (self) {
+            .unknown => false,
+            .floating => |value| value.fitsInteger(bits, signed),
+            .integer => |value| blk: {
+                if (signed and bits >= 128) break :blk true;
+                if (!signed and bits >= 127) break :blk value.min >= 0;
+                const target = integerType(bits, signed);
+                if (target != .integer) break :blk false;
+                break :blk value.min >= target.integer.min and value.max <= target.integer.max;
+            },
+        };
+    }
+
+    pub fn exactInF32(self: Range) bool {
+        if (self != .integer) return false;
+        const value = self.integer;
+        if (value.min >= -16777216 and value.max <= 16777216) return true;
+        if (value.min != value.max) return false;
+        const magnitude = @abs(value.min);
+        std.debug.assert(magnitude != 0);
+        return 128 - @clz(magnitude) - @ctz(magnitude) <= 24;
+    }
+
+    pub fn join(a: Range, b: Range) Range {
+        if (a == .integer and b == .integer) return .{ .integer = .{
+            .min = @min(a.integer.min, b.integer.min),
+            .max = @max(a.integer.max, b.integer.max),
+        } };
+        if (a != .floating or b != .floating) return .unknown;
+        const x = a.floating;
+        const y = b.floating;
+        return .{ .floating = .{
+            .min = @min(x.min, y.min),
+            .max = @max(x.max, y.max),
+            .min_open = if (x.min < y.min) x.min_open else if (y.min < x.min) y.min_open else x.min_open and y.min_open,
+            .max_open = if (x.max > y.max) x.max_open else if (y.max > x.max) y.max_open else x.max_open and y.max_open,
+            .no_nan = x.no_nan and y.no_nan,
+        } };
+    }
+
+    pub fn intersect(a: Range, b: Range) Range {
+        if (a == .unknown) return b;
+        if (b == .unknown) return a;
+        if (a == .integer and b == .integer) {
+            const low = @max(a.integer.min, b.integer.min);
+            const high = @min(a.integer.max, b.integer.max);
+            if (low > high) return .unknown;
+            return .{ .integer = .{ .min = low, .max = high } };
+        }
+        if (a != .floating or b != .floating) return .unknown;
+        const x = a.floating;
+        const y = b.floating;
+        const low = @max(x.min, y.min);
+        const high = @min(x.max, y.max);
+        if (low > high) return .unknown;
+        return .{ .floating = .{
+            .min = low,
+            .max = high,
+            .min_open = if (x.min > y.min) x.min_open else if (y.min > x.min) y.min_open else x.min_open or y.min_open,
+            .max_open = if (x.max < y.max) x.max_open else if (y.max < x.max) y.max_open else x.max_open or y.max_open,
+            .no_nan = x.no_nan or y.no_nan,
+        } };
+    }
+
+    pub fn negate(self: Range) Range {
+        return switch (self) {
+            .unknown => .unknown,
+            .integer => |value| .{ .integer = .{
+                .min = std.math.negate(value.max) catch return .unknown,
+                .max = std.math.negate(value.min) catch return .unknown,
+            } },
+            .floating => |value| .{ .floating = .{
+                .min = -value.max,
+                .max = -value.min,
+                .min_open = value.max_open,
+                .max_open = value.min_open,
+                .no_nan = value.no_nan,
+            } },
+        };
+    }
+
+    pub fn asFloat(self: Range, bits: u16) Range {
+        var value: Floating = switch (self) {
+            .unknown => return .{ .floating = .{} },
+            .floating => |floating| floating,
+            .integer => |integer| blk: {
+                const exact: i128 = @as(i128, 1) << 113;
+                const low: f128 = @floatFromInt(integer.min);
+                const high: f128 = @floatFromInt(integer.max);
+                break :blk .{
+                    .min = if (integer.min >= -exact and integer.min <= exact) low else outward(low, false),
+                    .max = if (integer.max >= -exact and integer.max <= exact) high else outward(high, true),
+                    .no_nan = true,
+                };
+            },
+        };
+        if (bits != 16 and bits != 32 and bits != 64 and bits != 80 and bits != 128)
+            return .{ .floating = .{ .no_nan = value.no_nan } };
+        value.min = roundToFormat(value.min, bits);
+        value.max = roundToFormat(value.max, bits);
+        // A cast can round an excluded endpoint into an included value.
+        value.min_open = false;
+        value.max_open = false;
+        return .{ .floating = value };
+    }
+
+    pub fn binary(a: Range, b: Range, op: Operation) Range {
+        if (a == .integer and b == .integer) return integerBinary(a.integer, b.integer, op);
+        if (a == .unknown or b == .unknown) return .unknown;
+        const x = if (a == .floating) a.floating else a.asFloat(128).floating;
+        const y = if (b == .floating) b.floating else b.asFloat(128).floating;
+        return floatBinary(x, y, op);
+    }
+};
+
+fn integerBinary(a: Integer, b: Integer, op: Operation) Range {
+    const value: Integer = switch (op) {
+        .add => .{
+            .min = std.math.add(i128, a.min, b.min) catch return .unknown,
+            .max = std.math.add(i128, a.max, b.max) catch return .unknown,
+        },
+        .sub => .{
+            .min = std.math.sub(i128, a.min, b.max) catch return .unknown,
+            .max = std.math.sub(i128, a.max, b.min) catch return .unknown,
+        },
+        .minimum => .{ .min = @min(a.min, b.min), .max = @min(a.max, b.max) },
+        .maximum => .{ .min = @max(a.min, b.min), .max = @max(a.max, b.max) },
+        .mul, .div => return integerCorners(a, b, op),
+    };
+    return .{ .integer = value };
+}
+
+fn integerCorners(a: Integer, b: Integer, op: Operation) Range {
+    if (op == .div and b.min <= 0 and b.max >= 0) return .unknown;
+    var low: i128 = std.math.maxInt(i128);
+    var high: i128 = std.math.minInt(i128);
+    for ([_]i128{ a.min, a.max }) |left| {
+        for ([_]i128{ b.min, b.max }) |right| {
+            const value = switch (op) {
+                .mul => std.math.mul(i128, left, right) catch return .unknown,
+                .div => blk: {
+                    if (left == std.math.minInt(i128) and right == -1) return .unknown;
+                    break :blk @divTrunc(left, right);
+                },
+                else => unreachable,
+            };
+            low = @min(low, value);
+            high = @max(high, value);
+        }
+    }
+    return .{ .integer = .{ .min = low, .max = high } };
+}
+
+fn floatBinary(a: Floating, b: Floating, op: Operation) Range {
+    if (op == .minimum or op == .maximum) return floatMinMax(a, b, op);
+    if (!std.math.isFinite(a.min) or !std.math.isFinite(a.max) or
+        !std.math.isFinite(b.min) or !std.math.isFinite(b.max)) return .{ .floating = .{} };
+    if (op == .div and b.min <= 0 and b.max >= 0) return .{ .floating = .{} };
+    var low: f128 = inf;
+    var high: f128 = -inf;
+    for ([_]f128{ a.min, a.max }) |left| {
+        for ([_]f128{ b.min, b.max }) |right| {
+            const value = switch (op) {
+                .add => left + right,
+                .sub => left - right,
+                .mul => left * right,
+                .div => left / right,
+                else => unreachable,
+            };
+            if (std.math.isNan(value)) return .{ .floating = .{} };
+            low = @min(low, value);
+            high = @max(high, value);
+        }
+    }
+    return .{ .floating = .{
+        .min = outward(low, false),
+        .max = outward(high, true),
+        .no_nan = a.no_nan and b.no_nan,
+    } };
+}
+
+fn floatMinMax(a: Floating, b: Floating, op: Operation) Range {
+    const minimum = op == .minimum;
+    var low = if (minimum) @min(a.min, b.min) else @max(a.min, b.min);
+    var high = if (minimum) @min(a.max, b.max) else @max(a.max, b.max);
+    // If either operand can be NaN, Zig selects the other operand.
+    if (!a.no_nan) {
+        low = @min(low, b.min);
+        high = @max(high, b.max);
+    }
+    if (!b.no_nan) {
+        low = @min(low, a.min);
+        high = @max(high, a.max);
+    }
+    return .{ .floating = .{ .min = low, .max = high, .no_nan = a.no_nan or b.no_nan } };
+}
+
+fn outward(value: f128, up: bool) f128 {
+    return std.math.nextAfter(f128, value, if (up) inf else -inf);
+}
+
+fn roundToFormat(value: f128, bits: u16) f128 {
+    return switch (bits) {
+        16 => @as(f16, @floatCast(value)),
+        32 => @as(f32, @floatCast(value)),
+        64 => @as(f64, @floatCast(value)),
+        80 => @as(f80, @floatCast(value)),
+        128 => value,
+        else => unreachable,
+    };
+}
+
+pub fn powerOfTwo(exponent: u16) f128 {
+    std.debug.assert(exponent <= 128);
+    return std.math.scalbn(@as(f128, 1), @as(i32, exponent));
+}
+
+test "numeric intervals preserve inclusive and exclusive integer conversion bounds" {
+    const high = powerOfTwo(64);
+    const inclusive: Floating = .{ .min = 0, .max = high, .no_nan = true };
+    try std.testing.expect(!inclusive.fitsInteger(64, false));
+    var exclusive = inclusive;
+    exclusive.max_open = true;
+    try std.testing.expect(exclusive.fitsInteger(64, false));
+    exclusive.no_nan = false;
+    try std.testing.expect(!exclusive.fitsInteger(64, false));
+    try std.testing.expect(Range.floatConstant(-0.5).fitsInteger(8, false));
+    try std.testing.expect(!Range.floatConstant(-1).fitsInteger(8, false));
+}
+
+test "numeric intervals do not overflow their analysis representation" {
+    const largest = Range.constant(std.math.maxInt(i128));
+    try std.testing.expect(largest.binary(Range.constant(1), .add) == .unknown);
+    try std.testing.expect(Range.constant(std.math.minInt(i128)).negate() == .unknown);
+    try std.testing.expect(Range.integerType(25, true).exactInF32());
+    try std.testing.expect(!Range.constant(16777217).exactInF32());
+    const unsigned127 = Range.integerType(127, false);
+    try std.testing.expectEqual(@as(i128, 0), unsigned127.integer.min);
+    try std.testing.expectEqual(std.math.maxInt(i128), unsigned127.integer.max);
+}
+
+test "numeric clipping models NaN selection without accepting one sided bounds" {
+    const unknown: Range = .{ .floating = .{} };
+    const low = unknown.binary(Range.floatConstant(0), .maximum);
+    const high = unknown.binary(Range.floatConstant(255), .minimum);
+    try std.testing.expect(!low.fitsInteger(8, false));
+    try std.testing.expect(!high.fitsInteger(8, false));
+    try std.testing.expect(low.binary(Range.floatConstant(255), .minimum).fitsInteger(8, false));
+}
+
+test "f32 exactness includes representable isolated integers beyond consecutive coverage" {
+    const power: i128 = @as(i128, 1) << 30;
+    try std.testing.expect(Range.constant(power).exactInF32());
+    try std.testing.expect(Range.constant(-power).exactInF32());
+    try std.testing.expect(!Range.constant(power + 1).exactInF32());
+    try std.testing.expect(!Range.constant(-power - 1).exactInF32());
+    try std.testing.expect(Range.constant(std.math.minInt(i128)).exactInF32());
+    try std.testing.expect(!Range.constant(std.math.minInt(i128) + 1).exactInF32());
+    const interval: Range = .{ .integer = .{ .min = power, .max = power + 128 } };
+    try std.testing.expect(!interval.exactInF32());
+}
+
+test "wide integer destinations admit known bounds without admitting negative unsigned inputs" {
+    const positive = Range.constant(std.math.maxInt(i128));
+    try std.testing.expect(positive.fitsInteger(128, false));
+    try std.testing.expect(positive.fitsInteger(256, true));
+    try std.testing.expect(!Range.constant(-1).fitsInteger(128, false));
+    try std.testing.expect(!positive.fitsInteger(64, false));
+}
+
+test "IEEE mask bounds contain every admitted binary16 value" {
+    const Case = struct { mask: u16, min: u16 = 0, max: u16 };
+    const cases = [_]Case{
+        .{ .mask = 0x7fff, .max = 0x3c00 },
+        .{ .mask = 0x7c00, .max = 0x3c01 },
+        .{ .mask = 0x7c00, .max = 0x3bff },
+        .{ .mask = 0x7d55, .max = 0x3caa },
+        .{ .mask = 0xffff, .max = 0x3c00 },
+        .{ .mask = 0xffff, .min = 0x8000, .max = 0xbc00 },
+    };
+    for (cases) |case| {
+        const range = ieeeFloatRange(16, case.mask, .{ .integer = .{
+            .min = case.min,
+            .max = case.max,
+        } }, false);
+        try std.testing.expect(range == .floating);
+        try std.testing.expect(range.floating.no_nan);
+        for (0..65536) |raw| {
+            const bits: u16 = @intCast(raw);
+            const masked = bits & case.mask;
+            if (masked < case.min or masked > case.max) continue;
+            const value: f128 = @floatCast(@as(f16, @bitCast(bits)));
+            try std.testing.expect(value >= range.floating.min);
+            try std.testing.expect(value <= range.floating.max);
+        }
+    }
+}
