+fn summarizeReceiverMethod(
+    self: *Linter,
+    method_node: Ast.Node.Index,
+    method_depth: usize,
+) ?ReceiverLifetime {
+    if (method_depth >= 4) return null;
+
+    var fn_buf: [1]Ast.Node.Index = undefined;
+    const fn_proto = self.tree.fullFnProto(&fn_buf, method_node) orelse return null;
+    var param_it = fn_proto.iterate(&self.tree);
+    const first_param = param_it.next() orelse return null;
+    const param_name = first_param.name_token orelse return null;
+    const body_node = self.tree.nodeData(method_node).node_and_node[1];
+    const next_depth = method_depth + 1;
+    const lifetime = self.analyzeReceiverLifetime(
+        body_node,
+        self.tree.tokenSlice(param_name),
+        false,
+        next_depth,
+    );
+    if (self.hasUnsafeReturn(body_node, self.tree.tokenSlice(param_name), false, next_depth)) return null;
+    if (!lifetime.saw_terminal) return null;
+    if (lifetime.can_fallthrough and !lifetime.terminal_on_fallthrough) return null;
+    if (lifetime.invalidation_after_destroy or lifetime.deferred_invalidation_after_destroy or
+        lifetime.receiver_write_after_destroy or lifetime.deferred_receiver_write_after_destroy)
+    {
+        return null;
+    }
+    if (lifetime.unsafe_terminal_order) return null;
+    return lifetime;
+}
+
+fn isReceiverTerminalAction(
+    self: *Linter,
+    node: Ast.Node.Index,
+    param_name: []const u8,
+    method_depth: usize,
+) bool {
+    if (self.isSelfUndefinedAssign(node, param_name)) return true;
+    if (self.isSelfDestroyCall(node, param_name)) return true;
+    if (self.isSafeSelfFieldAssign(node, param_name)) return true;
+    const method_node = self.selfMethodTarget(node, param_name) orelse return false;
+    return self.summarizeReceiverMethod(method_node, method_depth) != null;
+}
+
+fn isAssignmentTag(tag: Ast.Node.Tag) bool {
+    return switch (tag) {
+        .assign,
+        .assign_mul,
+        .assign_div,
+        .assign_mod,
+        .assign_add,
+        .assign_sub,
+        .assign_shl,
+        .assign_shl_sat,
+        .assign_shr,
+        .assign_bit_and,
+        .assign_bit_xor,
+        .assign_bit_or,
+        .assign_mul_wrap,
+        .assign_add_wrap,
+        .assign_sub_wrap,
+        .assign_mul_sat,
+        .assign_add_sat,
+        .assign_sub_sat,
+        => true,
+        else => false,
+    };
+}
+
+fn isSelfReceiverWrite(self: *Linter, node: Ast.Node.Index, param_name: []const u8) bool {
+    if (!isAssignmentTag(self.tree.nodeTag(node))) return false;
+    const assign_data = self.tree.nodeData(node).node_and_node;
+    const lhs = assign_data[0];
+    if (self.tree.nodeTag(lhs) == .deref) {
+        const inner = self.tree.nodeData(lhs).node;
+        if (self.tree.nodeTag(inner) != .identifier) return false;
+        return std.mem.eql(u8, self.tree.tokenSlice(self.tree.nodeMainToken(inner)), param_name);
+    }
+    return self.receiverFieldName(lhs, param_name) != null;
+}
+
+fn receiverFieldName(
+    self: *Linter,
+    node: Ast.Node.Index,
+    param_name: []const u8,
+) ?[]const u8 {
+    if (self.tree.nodeTag(node) != .field_access) return null;
+    const data = self.tree.nodeData(node).node_and_token;
+    if (self.tree.nodeTag(data[0]) != .identifier) return null;
+    const receiver_name = self.tree.tokenSlice(self.tree.nodeMainToken(data[0]));
+    if (!std.mem.eql(u8, receiver_name, param_name)) return null;
+    return self.tree.tokenSlice(data[1]);
+}
+
+fn isSelfMarkerMethodCall(self: *Linter, node: Ast.Node.Index, param_name: []const u8) bool {
+    var buf: [1]Ast.Node.Index = undefined;
+    const call = self.tree.fullCall(&buf, node) orelse return false;
+    const fn_expr = call.ast.fn_expr;
+    if (self.tree.nodeTag(fn_expr) != .field_access) return false;
+    const data = self.tree.nodeData(fn_expr).node_and_token;
+    const field_name = self.receiverFieldName(data[0], param_name) orelse return false;
+    if (!std.mem.eql(u8, field_name, "control")) return false;
+    const container = self.findEnclosingContainer(node).unwrap() orelse return false;
+    const members = self.getContainerMembers(container) orelse return false;
+    for (members) |member| {
+        const field = self.tree.fullContainerField(member) orelse continue;
