+            .ptr_type, .ptr_type_aligned, .ptr_type_bit_range, .ptr_type_sentinel => return false,
+            // `?T` and `E!T` carry the value itself.
+            .optional_type => node = datas[node].node,
+            .error_union => node = datas[node].node_and_node[1],
+            else => break,
