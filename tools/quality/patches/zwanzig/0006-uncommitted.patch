+/// pointer or slice layer keeps the conservative reading.
+fn declaredByValueContainer(query: *const QueryContext, expr: u32) bool {
+    const tree = query.tree;
+    const tags = tree.nodes.items(.tag);
+    const datas = tree.nodes.items(.data);
+    if (expr >= tags.len or tags[expr] != .identifier) return false;
+    const declared = bindingTypeExprNode(query, expr) orelse return false;
+    var node = declared;
+    for (0..8) |_| {
+        if (node >= tags.len) return false;
+        switch (tags[node]) {
