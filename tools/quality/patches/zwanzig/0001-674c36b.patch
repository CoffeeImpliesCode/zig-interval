+        try std.testing.expectEqualStrings("optional-unwrap", diagnostic.rule_id);
+    }
+    for (expected_lines) |expected_line| {
+        var found = false;
+        for (diagnostics.items) |diagnostic| {
+            if (diagnostic.range.start.line == expected_line) {
