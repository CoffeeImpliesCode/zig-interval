+
+/// `s` repeated `n` times, as a string literal would be (Zig 0.17 removed `**`).
+fn repeatString(comptime s: []const u8, comptime n: usize) *const [s.len * n:0]u8 {
+    comptime {
+        var out: [s.len * n:0]u8 = undefined;
+        for (0..n) |i| @memcpy(out[i * s.len ..][0..s.len], s);
+        const result = out;
+        return &result;
+    }
+}
