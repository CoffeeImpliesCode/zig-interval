diff --git a/src/no_resize_allocator.zig b/src/no_resize_allocator.zig
new file mode 100644
index 0000000..d73fa86
--- /dev/null
+++ b/src/no_resize_allocator.zig
@@ -0,0 +1,52 @@
+//! An allocator that never grows or shrinks in place: every resize and remap fails, so every
+//! size change is a fresh allocation, a copy and a free.
+//!
+//! For `std.testing.checkAllAllocationFailures`, which counts the allocations of one run and then
+//! replays it failing each one in turn. Zig 0.17's `std.testing.allocator` (a `SafeAllocator`)
+//! resizes in place or not depending on bucket occupancy, so a growing list allocates a different
+//! number of times from one run to the next and the replay reports
+//! `error.NondeterministicMemoryUsage`. Backed by this allocator, the count depends only on the
+//! code under test. Leaks are still caught by the child allocator.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+child: Allocator,
+
+const NoResizeAllocator = @This();
+
+pub fn init(child: Allocator) NoResizeAllocator {
+    return .{ .child = child };
+}
+
+pub fn allocator(self: *NoResizeAllocator) Allocator {
+    return .{
+        .ptr = self,
+        .vtable = &.{
+            .alloc = alloc,
+            .resize = Allocator.noResize,
+            .remap = Allocator.noRemap,
+            .free = free,
+        },
+    };
+}
+
+fn alloc(ctx: *anyopaque, len: usize, alignment: std.mem.Alignment, ret_addr: usize) ?[*]u8 {
+    const self: *NoResizeAllocator = @ptrCast(@alignCast(ctx));
+    return self.child.rawAlloc(len, alignment, ret_addr);
+}
+
+fn free(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, ret_addr: usize) void {
+    const self: *NoResizeAllocator = @ptrCast(@alignCast(ctx));
+    self.child.rawFree(memory, alignment, ret_addr);
+}
+
+test "in-place growth and shrinking always fail" {
+    var no_resize: NoResizeAllocator = .init(std.testing.allocator);
+    const gpa = no_resize.allocator();
+    const memory = try gpa.alloc(u8, 16);
+    defer gpa.free(memory); // through the child, whose leak check would report a lost free
+    try std.testing.expect(!gpa.resize(memory, 8));
+    try std.testing.expect(!gpa.resize(memory, 32));
+    try std.testing.expect(gpa.remap(memory, 32) == null);
+}
