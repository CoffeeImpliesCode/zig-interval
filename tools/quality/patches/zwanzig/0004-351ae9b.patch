+            TestEngine.BranchConstraints.extractAssertionConstraint(&engine, call_node, &cfg)) orelse
+            return error.TestUnexpectedResult;
+        try std.testing.expect(constraint.eql(Constraint.nullCheck(var_id, false)));
+    }
+}
